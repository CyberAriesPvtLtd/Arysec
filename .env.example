# ---------------------------------------------------------------------------
# Arysec Technologies LLP — server configuration
#
# Copy to .env and fill in. Never commit the real .env file.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Number of reverse proxies in front of the app (nginx, Cloudflare, a load
# balancer). MUST match reality: too high and a client can spoof X-Forwarded-For
# to evade rate limiting; too low and every request appears to come from the proxy.
#   direct to the internet   -> 0
#   behind one nginx         -> 1
#   Cloudflare + nginx       -> 2
TRUST_PROXY=1

# Comma-separated origins allowed to POST to /api/*. Required in production.
ALLOWED_ORIGINS=https://www.arysec.in,https://arysec.in

# Email notifications -------------------------------------------------------
# Leave SMTP_HOST empty to disable email. Submissions are still stored in the
# database, but nobody is notified — set this before going live.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAIL_FROM="Arysec Website <no-reply@arysec.in>"
MAIL_TO=info@arysec.in
MAIL_CAREERS_TO=careers@arysec.in

# Storage -------------------------------------------------------------------
# Keep both OUTSIDE the public/ directory so uploads are never web-servable.
DB_FILE=./server/data/submissions.db
UPLOAD_DIR=./server/uploads
MAX_UPLOAD_BYTES=5242880

# Anti-spam -----------------------------------------------------------------
# Minimum seconds between form render and submit. Bots post instantly.
MIN_FORM_SECONDS=3
MAX_FORM_AGE_SECONDS=21600

# Rate limiting -------------------------------------------------------------
RATE_WINDOW_MS=900000
RATE_FORM_MAX=5
RATE_GLOBAL_MAX=300

# Logging -------------------------------------------------------------------
LOG_LEVEL=info

# Salt for hashing client IPs in logs and the database. Set this to a long random
# value so hashes stay stable across restarts; leave empty for a random per-process
# salt (hashes then cannot be correlated between restarts).
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
