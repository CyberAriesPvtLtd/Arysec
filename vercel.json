{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/academy",
      "has": [{ "type": "host", "value": "academy.arysec.in" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/academy/:path*",
      "has": [{ "type": "host", "value": "academy.arysec.in" }],
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/academy",
      "has": [{ "type": "host", "value": "www.arysec.in" }],
      "destination": "https://academy.arysec.in/",
      "permanent": true
    },
    {
      "source": "/academy/:path*",
      "has": [{ "type": "host", "value": "www.arysec.in" }],
      "destination": "https://academy.arysec.in/:path*",
      "permanent": true
    },
    {
      "source": "/academy",
      "has": [{ "type": "host", "value": "arysec.in" }],
      "destination": "https://academy.arysec.in/",
      "permanent": true
    },
    {
      "source": "/academy/:path*",
      "has": [{ "type": "host", "value": "arysec.in" }],
      "destination": "https://academy.arysec.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "academy.arysec.in" }],
      "destination": "/academy/:path*"
    }
  ]
}
