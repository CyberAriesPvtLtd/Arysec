{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/academy",
      "has": [{ "type": "host", "value": "academy.arysec.in" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/academy/(.*)",
      "has": [{ "type": "host", "value": "academy.arysec.in" }],
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/academy",
      "has": [{ "type": "host", "value": "www.arysec.in" }],
      "destination": "https://academy.arysec.in/",
      "permanent": true
    },
    {
      "source": "/academy/(.*)",
      "has": [{ "type": "host", "value": "www.arysec.in" }],
      "destination": "https://academy.arysec.in/$1",
      "permanent": true
    },
    {
      "source": "/academy",
      "has": [{ "type": "host", "value": "arysec.in" }],
      "destination": "https://academy.arysec.in/",
      "permanent": true
    },
    {
      "source": "/academy/(.*)",
      "has": [{ "type": "host", "value": "arysec.in" }],
      "destination": "https://academy.arysec.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "academy.arysec.in" }],
      "destination": "/academy/$1"
    }
  ]
}
