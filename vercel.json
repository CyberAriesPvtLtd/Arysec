{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/academy",
      "has": [
        {
          "type": "host",
          "value": "academy.arysec.in"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/academy/(.*)",
      "has": [
        {
          "type": "host",
          "value": "academy.arysec.in"
        }
      ],
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/academy",
      "has": [
        {
          "type": "host",
          "value": "www.arysec.in"
        }
      ],
      "destination": "https://academy.arysec.in/",
      "permanent": true
    },
    {
      "source": "/academy/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.arysec.in"
        }
      ],
      "destination": "https://academy.arysec.in/$1",
      "permanent": true
    },
    {
      "source": "/academy",
      "has": [
        {
          "type": "host",
          "value": "arysec.in"
        }
      ],
      "destination": "https://academy.arysec.in/",
      "permanent": true
    },
    {
      "source": "/academy/(.*)",
      "has": [
        {
          "type": "host",
          "value": "arysec.in"
        }
      ],
      "destination": "https://academy.arysec.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/gateway"
    }
  ]
}
